#!/usr/bin/env bash
# sala-web-ttyd-attach: the command sala-web-ttyd.service has ttyd run for each browser tab at /tty/.
# /tty/?arg=<session> attaches that tmux session; without an argument (or with an unknown or invalid name) it lists the sessions
# and attaches the one whose name is typed, so nothing is attached by accident. ttyd passes the URL argument as argv (no shell),
# and the name is still checked against [A-Za-z0-9._-] before it reaches tmux.
# SALA_WEB_TMUX_SOCKET (the same variable sala-web reads): a private tmux server's name (tmux -L); empty = the default server.
set -u
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
unset TMUX
T=(tmux)
[ -n "${SALA_WEB_TMUX_SOCKET:-}" ] && T=(tmux -L "$SALA_WEB_TMUX_SOCKET")

valid() { [[ -n "$1" && "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }

if [[ $# -ge 1 ]]; then
  if valid "$1" && "${T[@]}" has-session -t "=$1" 2>/dev/null; then
    exec "${T[@]}" attach-session -t "=$1"
  fi
  if valid "$1"; then
    printf 'No tmux session named "%s".\n\n' "$1"
  else
    printf 'Ignored an invalid session name (allowed: A-Z a-z 0-9 . _ -).\n\n'
  fi
fi

printf 'tmux sessions:\n'
"${T[@]}" list-sessions -F '  #S' 2>/dev/null
printf '\nType a session name and press Enter: '
IFS= read -r choice || exit 0
if valid "$choice" && "${T[@]}" has-session -t "=$choice" 2>/dev/null; then
  exec "${T[@]}" attach-session -t "=$choice"
fi
printf 'No such session. Closing; reload the page to try again.\n'
sleep 3
