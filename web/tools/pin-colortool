#!/usr/bin/env python3
"""Pin stackshot's shared color tool into sala: copy its file verbatim and rewrite the sha file beside the copy.

    web/tools/pin-colortool [path/to/stackshot/shared/colortool.js]

The source defaults to ~/stackshot/shared/colortool.js. The copy is `src/sala_web/static/colortool.js`, byte for byte (sala never edits it:
the tool is owned by stackshot, and a change comes by pinning a newer copy), and `colortool.js.sha256` next to it holds the copy's sha256 in
`sha256sum` form. The first line of the source must be `/* colortool vN */`; anything else is refused and nothing is written.
The test `web/tests/test_colortool_wiring.py` fails when the copy and the sha file differ."""

from __future__ import annotations

import hashlib
import os
import re
import sys
import tempfile
from pathlib import Path

STATIC = Path(__file__).resolve().parent.parent / "src" / "sala_web" / "static"
DEFAULT = Path("~/stackshot/shared/colortool.js").expanduser()


def write_atomic(path: Path, data: bytes) -> None:
    """Replace `path` with `data` in one rename, so a stop never leaves half a file."""
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if len(argv) > 1:
        print(__doc__, file=sys.stderr)
        return 2
    src = Path(argv[0]).expanduser() if argv else DEFAULT
    try:
        data = src.read_bytes()
    except OSError as e:
        print(f"pin-colortool: cannot read {src}: {e.strerror}", file=sys.stderr)
        return 1
    first = data.split(b"\n", 1)[0].decode("utf-8", "replace")
    m = re.fullmatch(r"/\* colortool v(\d+) \*/", first)
    if not m:
        print(f"pin-colortool: {src} does not start with `/* colortool vN */` (line 1 is {first[:60]!r}); nothing written", file=sys.stderr)
        return 1
    digest = hashlib.sha256(data).hexdigest()
    write_atomic(STATIC / "colortool.js", data)
    write_atomic(STATIC / "colortool.js.sha256", f"{digest}  colortool.js\n".encode())
    print(f"pinned colortool v{m.group(1)} from {src}\nsha256 {digest}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
