<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS equivalent of systemd/sala-heartbeat.timer: `salamander heartbeat` every 2 min.
     Install: cp launchd/ai.salamander.heartbeat.plist ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/ai.salamander.heartbeat.plist
     Replace USER. Not yet exercised on a Mac (no host); the helpers it relies on are ps/lsof-based and verified on Linux. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.salamander.heartbeat</string>
  <key>ProgramArguments</key><array><string>/Users/USER/.local/bin/salamander</string><string>heartbeat</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/USER/.claude/salamander-heartbeat.out</string>
  <key>StandardErrorPath</key><string>/Users/USER/.claude/salamander-heartbeat.out</string>
</dict></plist>
