[Unit]
Description=Usage analysis count: count what this machine's Claude Code replies cost at list prices and save it where sala-web reads it
X-Model-Lane=none
X-Project=sala/salamander
X-Runs-With=sessions
OnFailure=sala-job-failed@%n.service

[Service]
Type=oneshot
ExecStart=%h/salamander/web/contrib/sala-web-usage-count
ExecStopPost=-%h/salamander/bin/salamander job alert ok %n
